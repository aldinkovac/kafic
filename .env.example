# Iz Supabase projekta: Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://tvoj-projekat.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tvoj-anon-kljuc

# Obavještenja na telefon (web push). Javni ključ smije biti javan, privatni nikad u Git.
# Nove ključeve praviš sa: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Supabase > Settings > API > service_role (tajno, samo u Vercelu)
SUPABASE_SERVICE_ROLE_KEY=
